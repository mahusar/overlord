# copy to /etc/overlordhub.env, chmod 600, chown overlord:overlord
# it holds the daemon rpc password, so it must not be world readable

XST_RPC_HOST=127.0.0.1
XST_RPC_PORT=46502
XST_RPC_USER=changeme
XST_RPC_PASSWORD=changeme

# the port Tor forwards to. keep the bind on loopback
OVERLORD_HUB_PORT=7790
OVERLORD_BIND=127.0.0.1
